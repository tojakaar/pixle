# OpenAI-compatible API credentials (read by the Tauri/Rust backend only).
#
# Setup:
#   cp .env.example .env
#   # edit .env and replace the placeholder with your real key
#
# The app loads `.env` (project root or src-tauri/). It does NOT read this file.
# Never commit `.env`.

OPENAI_API_KEY=sk-your-key-here

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
